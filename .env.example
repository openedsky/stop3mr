# MySQL (XAMPP default)
DATABASE_URL="mysql://root:@localhost:3306/stop3mr"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changez-moi-en-production-avec-openssl-rand-base64-32"

# Seau rate-limit interne (distinct du secret JWT)
RL_INTERNAL_SECRET="changez-moi-rl-interne-openssl-rand-base64-32xxxx"

# Chiffrement AES-256 pour données clients (32 bytes hex = 64 chars)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Site de production par défaut (code dans numéro de série)
DEFAULT_SITE_CODE="PR"

# URL publique de l'application (pour QR codes)
APP_PUBLIC_URL="http://localhost:3000"

# Notifications e-mail (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL="admin@stop3mr.ci"

# SMS (optionnel - passerelle locale)
SMS_API_URL=""
SMS_API_KEY=""

# Compte contribuable entreprise
COMPTE_CONTRIBUABLE="CI-XXXXX"

# "true" uniquement derrière nginx/caddy qui ÉCRASE X-Forwarded-For.
# "false" sur XAMPP local (sinon spoofing du rate-limit). Obligatoire en production.
TRUST_PROXY=false
