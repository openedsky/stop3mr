{
  "name": "stop3mr-platform",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node server.js",
    "db:deploy": "prisma db push",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:territoire": "tsx prisma/seed-territoire.ts",
    "db:seed:volume": "tsx prisma/seed-volume.ts",
    "db:repair:test": "tsx prisma/repair-donnees-test.ts",
    "test": "tsx --test src/lib/commissions.test.ts src/lib/races.test.ts src/lib/security.test.ts",
    "db:repair:audit": "tsx prisma/repair-audit-complet.ts",
    "db:repair:recus": "tsx prisma/repair-recus-payee.ts",
    "db:backfill:prenom": "tsx prisma/backfill-prenom.ts",
    "db:backfill:codes": "tsx prisma/backfill-code-commercial.ts",
    "db:backfill:commissions-ct": "tsx prisma/backfill-commissions-ct.ts",
    "db:sync:passwords": "tsx prisma/sync-passwords.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/dejavu-sans": "^5.3.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "^15.2.0",
    "next-auth": "^4.24.11",
    "prisma": "^6.5.0",
    "nodemailer": "9.0.1",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.0",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "zod": "^3.24.2",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "nodemailer": "$nodemailer",
    "postcss": "8.5.26",
    "sharp": "$sharp",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "tsx": "^4.19.3"
  }
}
